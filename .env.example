SHHH_PORT=8000
SHHH_BASE_URL=
# CORS: empty = disabled (same-origin only). Set to your origin for cross-origin access.
# Example: SHHH_CORS_ORIGIN=https://app.example.com
# SHHH_CORS_ORIGIN=
SHHH_MIN_PHRASE_SIZE=5
SHHH_MAX_PHRASE_SIZE=128
SHHH_MAX_ITEMS=100
SHHH_MAX_FILE_SIZE=2097152
SHHH_MAX_RETENTION=24h
SHHH_VERBOSE=false

# ---- Channel feature (optional) ----
# Comma-separated list of 32-char lowercase hex UUIDs.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
# Server refuses to start if any UUID is malformed or duplicated.
# SHHH_CHANNELS=

# TTL for queued channel messages (0 = use SHHH_MAX_RETENTION)
SHHH_CHANNEL_MSG_TTL=24h

# Max dynamically-created channels via UI/API (0 = disabled, default)
# SHHH_CHANNEL_MAX_CHANNELS=0

# Lifetime of a dynamic channel since last message (0 = use SHHH_CHANNEL_MSG_TTL)
# SHHH_CHANNEL_LIFETIME=24h

# Max messages held in each channel queue (default 20)
SHHH_CHANNEL_MAX_MSGS=20

# Max concurrent SSE watchers per channel (default 10)
# Memory worst-case: SHHH_CHANNEL_MAX_WATCHERS * SHHH_CHANNEL_MAX_MSGS * SHHH_MAX_FILE_SIZE
# Default: 10 * 20 * 2MB = 400 MB
SHHH_CHANNEL_MAX_WATCHERS=10

# SSE new-connection rate limit per IP (req/s, default 2)
SHHH_WATCH_RPS_PER_IP=2

# Max concurrent SSE connections per IP (default 3)
SHHH_WATCH_CONN_PER_IP=3

# Trusted reverse-proxy IPs/CIDRs for X-Forwarded-For (comma-separated).
# Without this, private-range IPs are trusted. Set explicitly in production.
# Example: SHHH_TRUSTED_PROXIES=10.0.0.1,172.16.0.0/12
# SHHH_TRUSTED_PROXIES=
